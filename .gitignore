# ── Large binary inputs (not source) ──
# Apple artifacts the extractor reads: dyld shared cache (many GB), the locationd
# binary, etc.  Point at them with MACHO_DATA_DIR, or symlink them in as ./iphone8_data
# (no trailing slash below, so a symlink is ignored as well as a directory).
/iphone8_data
/iphone12_data
/ios27_data
/macos27_data
/dylib
/locationd
/geod
/GeoServices

# ── Network captures (can hold device identifiers / location data) ──
*.mitm
# the synthetic example capture used by the README quick start
!/examples/example.mitm

# ── Extractor .proto output dirs (generated by cli.py -o) ──
/out_*/

# ── Caches and build products ──
.descriptor_cache/
__pycache__/
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/

# ── Local environments ──
/venv/
/.venv/

# ── Synthetic-fixture link-time shim: regenerated by build_fixtures.sh ──
apple_protobuf_extractor/tests/synthetic_fixtures/shim/libpbshim.dylib

# ── Editor / OS ──
.DS_Store
